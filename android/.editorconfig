root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_function_naming_ignore_when_annotated_with = Composable
compose_check_modifiers_for_visibility = all
ktlint_standard_no-wildcard-imports = enabled
compose_preview_naming_enabled = true
compose_preview_naming_strategy = anywhere
compose_allowed_composition_locals = LocalInvitationTypography, LocalInvitationColorScheme, LocalInvitationShapes
max_line_length = 120
ktlint_standard_package-name = disabled

[**/build/**]
ktlint = disabled